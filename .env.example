# Prism settings: LAPTOP ONLY. On the Jarvis VM the settings live in /etc/prism/prism.env (root, 600), written by
# deploy/install.sh, and the secrets in /var/lib/prism/secrets.json (prism user, 600). Never commit a .env.

PRISM_ENVIRONMENT=dev
PRISM_AUTH_MODE=dev                       # no sign-in, you're admin; refused unless PRISM_PUBLIC_URL is localhost
PRISM_PUBLIC_URL=http://localhost:8040/prism
PRISM_BASE_PATH=/prism
PRISM_DATABASE_URL=sqlite:///./prism.db
PRISM_SECRET_BACKEND=env                  # keys as PRISM_SECRET_PRISM_OPENAI_API_KEY=... (only needed for real engines)
PRISM_ADMIN_EMAILS=aman@farviewequity.com

# Production shape, for reference (deploy/install.sh writes these on the VM):
# PRISM_ENVIRONMENT=production
# PRISM_AUTH_MODE=entra
# PRISM_PUBLIC_URL=https://jarvis.farviewequity.com/prism
# PRISM_SESSION_SECRET=<48+ random characters>
# PRISM_ENTRA_TENANT_ID=... / PRISM_ENTRA_CLIENT_ID=...   (secret: sudo prism set-key entra)
# PRISM_DATABASE_URL=mssql+pyodbc://prismapp:<pw>@farview.database.windows.net:1433/jarvis?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
# PRISM_SECRET_BACKEND=file
# PRISM_SECRETS_FILE=/var/lib/prism/secrets.json
