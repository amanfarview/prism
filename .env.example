# Prism settings. Copy to /home/azureuser/prism/.env on the Jarvis VM.
# Secrets (API keys, Entra client secret, Teams webhook) live in Azure Key Vault, not here.

# Shared Farview Azure SQL database, own schema "prism" (created on first start).
# Use the same server/database and auth method Orbit uses. Managed identity example:
PRISM_DATABASE_URL=mssql+pyodbc://@YOUR-SERVER.database.windows.net/YOUR-DB?driver=ODBC+Driver+17+for+SQL+Server&Authentication=ActiveDirectoryMsi
PRISM_DB_SCHEMA=prism

PRISM_BASE_PATH=/prism
PRISM_PUBLIC_URL=https://jarvis.farviewequity.com/prism
PRISM_SESSION_SECRET=generate-with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# Sign-in with the existing "Farview Apps" Entra registration.
# Add redirect URI https://jarvis.farviewequity.com/prism/auth/callback to that registration.
PRISM_AUTH_MODE=entra
PRISM_ENTRA_TENANT_ID=
PRISM_ENTRA_CLIENT_ID=
PRISM_ENTRA_CLIENT_SECRET_NAME=prism-entra-client-secret
PRISM_ADMIN_EMAILS=aman@farviewequity.com,david@farviewequity.com

# Azure Key Vault (the VM's managed identity needs get/set/list on secrets)
PRISM_SECRET_BACKEND=keyvault
PRISM_KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net/

PRISM_MAX_WORKERS=6
