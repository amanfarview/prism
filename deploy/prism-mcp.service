[Unit]
Description=Prism MCP server (read-only, token protected)
After=network-online.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/prism
EnvironmentFile=/home/azureuser/prism/.env
ExecStart=/home/azureuser/prism/venv/bin/python -m prism.mcp_server --http
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
